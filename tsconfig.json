{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "moduleDetection": "force",
        "lib": ["ESNext"],
        "types": ["bun"],
        "strict": true,
        "skipLibCheck": true,
        "verbatimModuleSyntax": true,
        "noEmit": true
    },
    "include": ["index.ts"]
}
